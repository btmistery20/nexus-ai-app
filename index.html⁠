<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus AI Signal Terminal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        nexus: {
                            900: '#030712',
                            800: '#0B132B',
                            700: '#1C2541',
                            600: '#3A506B',
                            accent: '#00F0FF',
                            success: '#10B981',
                            danger: '#EF4444'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glow { box-shadow: 0 0 20px rgba(0, 240, 255, 0.15); }
        .glow-success { box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); }
    </style>
</head>
<body class="bg-nexus-900 text-gray-100 min-h-screen font-sans antialiased pb-20" x-data="tradingApp()">

    <!-- Top Header -->
    <header class="bg-nexus-800 border-b border-nexus-700 p-4 sticky top-0 z-50 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-nexus-700 flex items-center justify-center border border-nexus-accent/40 glow">
                <span class="text-nexus-accent font-bold text-lg">⚡</span>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-wider text-white">NEXUS AI TERMINAL</h1>
                <p class="text-xs text-nexus-accent flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-nexus-success animate-pulse"></span>
                    Live Neural Scanner Active
                </p>
            </div>
        </div>
        <button @click="toggleScanner()" :class="scanning ? 'bg-nexus-danger/20 text-nexus-danger border-nexus-danger/50' : 'bg-nexus-accent/20 text-nexus-accent border-nexus-accent/50'" class="px-3 py-1.5 rounded-lg border text-xs font-semibold uppercase tracking-wider transition">
            <span x-text="scanning ? 'Pause Feed' : 'Resume Scan'"></span>
        </button>
    </header>

    <!-- Main Content -->
    <main class="p-4 space-y-4 max-w-lg mx-auto">

        <!-- Active Signal Banner -->
        <div class="bg-nexus-800/80 border border-nexus-700 rounded-2xl p-4 glow relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-nexus-accent/10 text-nexus-accent text-[10px] font-bold px-3 py-1 rounded-bl-xl border-l border-b border-nexus-accent/30">
                HIGH CONFIDENCE SIGNAL
            </div>
            
            <div class="flex justify-between items-start mb-3">
                <div>
                    <span class="text-xs text-gray-400 font-mono" x-text="currentSignal.pair"></span>
                    <h2 class="text-2xl font-black text-white tracking-wide" x-text="currentSignal.asset"></h2>
                </div>
                <div class="text-right">
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase" :class="currentSignal.type === 'LONG' ? 'bg-nexus-success/20 text-nexus-success border border-nexus-success/40' : 'bg-nexus-danger/20 text-nexus-danger border border-nexus-danger/40'" x-text="currentSignal.type"></span>
                </div>
            </div>

            <!-- Price & Metrics Grid -->
            <div class="grid grid-cols-3 gap-2 bg-nexus-900/60 p-3 rounded-xl border border-nexus-700/50 mb-4">
                <div>
                    <span class="text-[10px] text-gray-400 block">ENTRY PRICE</span>
                    <span class="font-mono font-bold text-sm text-white" x-text="currentSignal.entry"></span>
                </div>
                <div>
                    <span class="text-[10px] text-gray-400 block">TARGET (TP)</span>
                    <span class="font-mono font-bold text-sm text-nexus-success" x-text="currentSignal.tp"></span>
                </div>
                <div>
                    <span class="text-[10px] text-gray-400 block">CONFIDENCE</span>
                    <span class="font-mono font-bold text-sm text-nexus-accent" x-text="currentSignal.confidence + '%'"></span>
                </div>
            </div>

            <!-- Confidence Meter -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs">
                    <span class="text-gray-400">AI Neural Weight</span>
                    <span class="font-mono font-bold text-nexus-accent" x-text="currentSignal.confidence + '%'"></span>
                </div>
                <div class="w-full bg-nexus-900 h-2 rounded-full overflow-hidden border border-nexus-700">
                    <div class="bg-gradient-to-r from-nexus-600 to-nexus-accent h-full transition-all duration-500" :style="`width: ${currentSignal.confidence}%`"></div>
                </div>
            </div>
        </div>

        <!-- Simulated Live Chart Stream -->
        <div class="bg-nexus-800/80 border border-nexus-700 rounded-2xl p-4">
            <div class="flex justify-between items-center mb-3">
                <h3 class="text-xs font-bold tracking-wider text-gray-300 uppercase">Live Price Action & Simulation</h3>
                <span class="text-[10px] font-mono text-nexus-accent bg-nexus-accent/10 px-2 py-0.5 rounded border border-nexus-accent/30">M1 Scalp Engine</span>
            </div>
            <div class="h-48 w-full relative">
                <canvas id="tradeChart"></canvas>
            </div>
        </div>

        <!-- Recent Signal Feed -->
        <div class="bg-nexus-800/80 border border-nexus-700 rounded-2xl p-4">
            <h3 class="text-xs font-bold tracking-wider text-gray-300 uppercase mb-3">Recent Neural Streams</h3>
            <div class="space-y-2.5">
                <template x-for="item in history">
                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-nexus-900/50 border border-nexus-700/40 text-xs">
                        <div class="flex items-center space-x-2">
                            <span class="w-2 h-2 rounded-full" :class="item.type === 'LONG' ? 'bg-nexus-success' : 'bg-nexus-danger'"></span>
                            <span class="font-bold text-white" x-text="item.asset"></span>
                            <span class="text-gray-400 font-mono text-[10px]" x-text="item.time"></span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <span class="font-mono text-nexus-accent" x-text="item.confidence + '%'"></span>
                            <span class="font-bold uppercase" :class="item.type === 'LONG' ? 'text-nexus-success' : 'text-nexus-danger'" x-text="item.type"></span>
                        </div>
                    </div>
                </template>
            </div>
        </div>

    </main>

    <!-- Bottom Action Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-nexus-800 border-t border-nexus-700 p-3 max-w-lg mx-auto flex gap-3">
        <button @click="triggerNewScan()" class="flex-1 bg-gradient-to-r from-nexus-600 to-nexus-accent text-nexus-900 font-bold py-3 rounded-xl text-sm shadow-lg tracking-wider active:scale-95 transition">
            ⚡ FORCE NEW SCAN
        </button>
    </nav>

    <script>
        function tradingApp() {
            return {
                scanning: true,
                currentSignal: { pair: 'BTC/USDT', asset: 'Bitcoin', type: 'LONG', entry: '$64,850.00', tp: '$67,200.00', confidence: 94.2 },
                history: [
                    { asset: 'ETH/USDT', type: 'LONG', confidence: 91.5, time: '2m ago' },
                    { asset: 'SOL/USDT', type: 'SHORT', confidence: 88.4, time: '7m ago' },
                    { asset: 'BNB/USDT', type: 'LONG', confidence: 89.9, time: '14m ago' }
                ],
                chart: null,
                init() {
                    // Initialize Telegram WebApp Styling Compatibility
                    if (window.Telegram && window.Telegram.WebApp) {
                        window.Telegram.WebApp.ready();
                        window.Telegram.WebApp.expand();
                    }
                    this.initChart();
                    this.startLoop();
                },
                initChart() {
                    const ctx = document.getElementById('tradeChart').getContext('2d');
                    this.chart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: ['1m', '2m', '3m', '4m', '5m', '6m', '7m', '8m', '9m', '10m'],
                            datasets: [{
                                label: 'Price Action',
                                data: [64200, 64350, 64300, 64500, 64420, 64600, 64750, 64690, 64810, 64850],
                                borderColor: '#00F0FF',
                                borderWidth: 2,
                                backgroundColor: 'rgba(0, 240, 255, 0.05)',
                                fill: true,
                                tension: 0.3,
                                pointRadius: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { grid: { display: false }, ticks: { color: '#6B7280', font: { size: 10 } } },
                                y: { grid: { color: 'rgba(28, 37, 65, 0.5)' }, ticks: { color: '#6B7280', font: { size: 10 } } }
                            }
                        }
                    });
                },
                startLoop() {
                    setInterval(() => {
                        if (!this.scanning) return;
                        // Random live fluctuations simulation
                        let lastVal = this.chart.data.datasets[0].data.pop();
                        let delta = (Math.random() - 0.48) * 120;
                        let newVal = Math.round((lastVal + delta) * 100) / 100;
                        this.chart.data.datasets[0].data.shift();
                        this.chart.data.datasets[0].data.push(newVal);
                        this.chart.update('none');
                    }, 2000);
                },
                toggleScanner() {
                    this.scanning = !this.scanning;
                },
                triggerNewScan() {
                    const assets = [
                        { pair: 'BTC/USDT', asset: 'Bitcoin', entry: '$64,850.00', tp: '$67,200.00' },
                        { pair: 'ETH/USDT', asset: 'Ethereum', entry: '$3,480.00', tp: '$3,650.00' },
                        { pair: 'SOL/USDT', asset: 'Solana', entry: '$148.50', tp: '$162.00' },
                        { pair: 'AVAX/USDT', asset: 'Avalanche', entry: '$28.40', tp: '$32.10' }
                    ];
                    const chosen = assets[Math.floor(Math.random() * assets.length)];
                    const type = Math.random() > 0.3 ? 'LONG' : 'SHORT';
                    const confidence = (88 + Math.random() * 10).toFixed(1);
                    
                    // Push current to history
                    this.history.unshift({ asset: chosen.asset, type: type, confidence: this.currentSignal.confidence, time: 'Just now' });
                    if (this.history.length > 5) this.history.pop();

                    this.currentSignal = { pair: chosen.pair, asset: chosen.asset, type: type, entry: chosen.entry, tp: chosen.tp, confidence: parseFloat(confidence) };
                }
            }
        }
    </script>
</body>
</html>
